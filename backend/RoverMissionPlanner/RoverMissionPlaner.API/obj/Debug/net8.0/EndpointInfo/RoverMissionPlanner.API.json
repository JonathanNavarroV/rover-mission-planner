{
  "openapi": "3.0.1",
  "info": {
    "title": "RoverMissionPlanner.API",
    "version": "1.0"
  },
  "paths": {
    "/rovers/{roverId}/Tasks": {
      "post": {
        "tags": [
          "Tasks"
        ],
        "parameters": [
          {
            "name": "roverId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoverTask"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RoverTask"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RoverTask"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "Tasks"
        ],
        "parameters": [
          {
            "name": "roverId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/rovers/{roverId}/utilization": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "parameters": [
          {
            "name": "roverId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RoverTask": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "roverName": {
            "type": "string",
            "nullable": true
          },
          "taskType": {
            "$ref": "#/components/schemas/TaskType"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "additionalProperties": false,
        "example": {
          "roverName": "Curiosity",
          "taskType": "Drill",
          "latitude": -4,5895,
          "longitude": 137,4417,
          "startsAt": "2025-07-07T10:00:00Z",
          "durationMinutes": 60,
          "status": "Planned"
        }
      },
      "TaskStatus": {
        "enum": [
          "Planned",
          "InProgress",
          "Completed",
          "Aborted"
        ],
        "type": "string"
      },
      "TaskType": {
        "enum": [
          "Drill",
          "Sample",
          "Photo",
          "Charge"
        ],
        "type": "string"
      }
    }
  }
}